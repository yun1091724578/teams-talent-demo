{
  "name": "teams-talent-carddemo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/run-services.mjs",
    "start:teams": "node scripts/run-services.mjs",
    "launch": "node scripts/launch.mjs --no-open",
    "launch:teams": "node scripts/launch.mjs --no-open",
    "stop": "node scripts/stop.mjs",
    "stop:teams": "node scripts/stop.mjs",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/browser.ts",
    "test:projects:e2e": "tsx tests/projects-browser.ts",
    "test:collaboration:e2e": "tsx tests/collaboration-cli.ts",
    "test:project-work:e2e": "tsx tests/project-work-browser.ts",
    "test:http": "node --import tsx tests/workflow-http.ts",
    "work:icode": "node scripts/icode-work.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.3",
    "protobufjs": "8.8.1",
    "marked": "15.0.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.9",
    "playwright": "1.63.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
